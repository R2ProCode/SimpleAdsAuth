<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 col-md-10 mx-auto">

            <div class="ad-form-card">

                <h2 class="ad-title">
                    Post a Free Item
                </h2>

                <form method="post" action="/home/newad">                    
                    <div class="row g-3">

                        <div class="col-md-6">
                            <input type="text" id="phone-number" name="phonenumber" placeholder="Phone Number" class="form-control ad-input" required>
                        </div>

                        <div class="col-12">
                            <textarea name="description" id="description" rows="8" placeholder="Describe the item you're giving away..." class="form-control ad-textarea" required></textarea>
                        </div>

                        <div class="col-12">
                            <button class="ad-submit-btn">
                                Post Ad
                            </button>
                        </div>

                    </div>

                </form>

            </div>

        </div>
    </div>
</div>