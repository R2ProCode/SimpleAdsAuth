@model AccountViewModel

<div class="container mt-5">
	<div class="row">
		<div class="col-lg-8 col-md-10 mx-auto">

			@foreach (var simpleAd in Model.SimpleAds)
			{
				<div class="ad-card">

					<div class="ad-badge">
                        FREE ITEM
                    </div>

					<h3 class="ad-name">
						@(simpleAd.UserName)
					</h3>

					<div class="ad-date">
						Listed on @simpleAd.DateCreated.ToLongDateString()
					</div>

					<div class="ad-phone">
						📞 @simpleAd.PhoneNumber
					</div>

					<div class="ad-details-title">
						Details
					</div>

					<p class="ad-description">
						@simpleAd.Description
					</p>

					<form method="post" action="/home/deletead">
						<input type="hidden" name="id" value="@simpleAd.Id" />
						<button type="submit" class="ad-delete-btn">
							🗑 Delete Ad
						</button>
					</form>
				</div>
			}

		</div>
	</div>
</div>